# ───────────── Sanity (CMS) ─────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Token de leitura (drafts/preview). Server-only.
SANITY_API_READ_TOKEN=
# Token de escrita — SÓ LOCAL, usado pelo script de seed. Nunca commitar.
SANITY_API_WRITE_TOKEN=
# Segredo que valida o webhook de revalidação do Sanity.
SANITY_REVALIDATE_SECRET=

# ───────────── Email (Resend) ─────────────
RESEND_API_KEY=
# Para onde as inscrições são enviadas (no demo: email do Felipe, verificado no Resend).
LEAD_RECIPIENT_EMAIL=
# Remetente. Sem domínio verificado, usar onboarding@resend.dev.
LEAD_FROM_EMAIL=onboarding@resend.dev
# Cópia opcional (BCC) durável.
LEAD_BCC_EMAIL=

# ───────────── Site ─────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
RATE_LIMIT_MAX=5
